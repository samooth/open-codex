{
  "name": "Open Codex",
  "version": "0.3.27",
  "description": "Tools for repo-wide maintenance.",
  "scripts": {
    "release": "cd codex-cli && npm run release",
    "format": "prettier --check .",
    "format:fix": "prettier --write . && prettier --write codex-cli",
    "typecheck": "tsc -p codex-cli/tsconfig.json --noEmit"
  },
  "devDependencies": {
    "prettier": "^3.5.3"
  },
  "engines": {
    "node": ">=22"
  }
}
